# Copy this file to ".env" in the same folder and change the password.
# ".env" is ignored by Git - never commit real passwords.

# --- PostgreSQL (used by compose.yaml) ---
POSTGRES_USER=healthspeak
POSTGRES_PASSWORD=change-me-local-dev-password
POSTGRES_DB=healthspeak
POSTGRES_PORT=5432

# --- FastAPI backend ---
# Must use the same user/password/database/port as above.
DATABASE_URL=postgresql+psycopg://healthspeak:change-me-local-dev-password@127.0.0.1:5432/healthspeak

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# development | production
APP_ENV=development

# --- Authentication ---
# How long a login lasts (minutes). 480 = 8 hours.
SESSION_TTL_MINUTES=480
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
DEFAULT_PHONE_COUNTRY_CODE=91

# Password for the SYNTHETIC demo users created by: python -m app.seed  (min 8 chars)
SEED_DEMO_PASSWORD=change-me-demo-password

# Optional: database used by pytest. Default = DATABASE_URL with "_test" appended to the name.
# TEST_DATABASE_URL=postgresql+psycopg://healthspeak:change-me-local-dev-password@127.0.0.1:5432/healthspeak_test

# --- Frontend (Vite reads VITE_* values from this same file) ---
# Address of the FastAPI backend used by the React app. Default shown.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# --- Local AI: speech recognition + translation (Phase 5) ---
# AI_ENABLED=true
# AI_DEVICE=auto                 # auto | cpu | cuda
# ASR_MODEL_ID=openai/whisper-small
# ASR_MODEL_REVISION=973afd24965f72e36ca33b3055d56a652f456b4d
# TRANSLATION_MODEL_ID=ai4bharat/indictrans2-indic-en-dist-200M
# TRANSLATION_MODEL_REVISION=d66a2122ad6d28184f3dc3797b652bd80ae3f65f
# Larger, more accurate translation model (~4.1 GB):
# TRANSLATION_MODEL_ID=ai4bharat/indictrans2-indic-en-1B
# TRANSLATION_MODEL_REVISION=ac3daf0ecd37be3b6957764a9179ab2b07fa9d6a
# Uploaded recordings: default folder is %LOCALAPPDATA%\HealthSpeakAI\audio (outside the project/OneDrive)
# AUDIO_STORAGE_DIR=
# AUDIO_MAX_SECONDS=120
# Keep raw audio after transcription? Only with documented consent/retention rules.
# AUDIO_KEEP_AFTER_PROCESSING=false
